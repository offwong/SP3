@startuml




' Superklasse for streamingtjenester
abstract class StreamingPlatform {
    - String name
    - ArrayList<MediaType> mediaTypes

    + StreamingPlatform(String name)
    + void createUser()
    + void logIn()


class User {
- String username
-String password
- ArrayList <MediaType> watchedMedia
- ArrayList <MediaType> savedMedia

+ User(String username, String password)
+ String getUsername()
+ String getPassword()

}


' Specifikke underklasser (kun hvis de har unik logik)


' Abstract superklasse for medier
abstract class MediaType {
    - String title
    - double rating
    - ArrayList<Category> categories

    + MediaType(String title, double rating)
}

' Underklasser med deres egne specifikke egenskaber
class Movie extends MediaType {
    - int durationMinutes

    + Movie(String title, double rating, int durationMinutes)
}

class Series extends MediaType {
    - int seasonsCount

    + Series(String title, double rating, int seasonsCount)
}

class Category {
    - String name

    + Category(String name)
}

package "util"{
class TextUI{
   Scanner scan
   + String promptText(String msg)
   + int promptNumeric(String msg)
   + void displayList(ArrayList<String> list, String msg)
   + void displayMessage(String msg)

}

class FileIO{

    + ArrayList<User> readUserData(String filePath)
    + void saveUserData(String filepath, ArrayList<User> users)


}
}



' Relationer
StreamingPlatform "1" o-- "*" MediaType : indeholder
MediaType "1" o-- "*" Category : tilhører
@enduml