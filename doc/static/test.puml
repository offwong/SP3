@startuml

' Styrer flow, menuer og brugerinteraktion
class Main {
    + {static} void main(String[] args)
}

class Menu {
    - Scanner scanner
    - StreamingPlatform platform
    - User loggedInUser

    + void displayStartMenu()
    + void displayMainMenu()
    + void handleUserChoice()
}

' Bruger-klasse med lister over medier
class User {
    - String username
    - String password
    - ArrayList<MediaType> watchedMedia
    - ArrayList<MediaType> savedMedia

    + User(String username, String password)
    + void addWatchedMedia(MediaType media)
    + void addSavedMedia(MediaType media)
    + void removeSavedMedia(MediaType media)
    + ArrayList<MediaType> getWatchedMedia()
    + ArrayList<MediaType> getSavedMedia()
}

' Overordnet platform eller system-holder
class StreamingPlatform {
    - String name
    - ArrayList<MediaType> mediaTypes
    - ArrayList<User> users

    + StreamingPlatform(String name)
    + void addMedia(MediaType media)
    + void addUser(User user)
    + User login(String username, String password)
    + ArrayList<MediaType> searchMedia(String title)
    + ArrayList<MediaType> getMediaByCategory(Category category)
}

' Abstrakt superklasse for medier (Film & Serier)
abstract class MediaType {
    - String title
    - String years
    - double rating
    - ArrayList<Category> categories

    + MediaType(String title, String years, double rating)
    + void addCategory(Category category)
    + String getTitle()
    + String getYears()
    + double getRating()
    + ArrayList<Category> getCategories()
}

class Movie extends MediaType {
    + Movie(String title, String years, double rating)
}

class Series extends MediaType {
    - ArrayList<Season> seasons

    + Series(String title, String years, double rating)
    + void addSeason(Season Season)
    + ArrayList<Season> getSeasons()
}

class Season {
    - int seasonNumber
    - ArrayList<Episode> episodes

    + Season(int seasonNumber)
    + void addEpisode(Episode episode)
    + ArrayList<Episode> getEpisodes()
}

class Episode {
    - String title
    - int episodeNumber

    + Episode(String title, int episodeNumber)
}

class Category {
    - String name

    + Category(String name)
    + String getName()
}

' Håndtering af tekstfiler (læsning af film/serier og brugere)
class FileIO {
    + ArrayList<MediaType> readMovieData(String filePath)
    + ArrayList<MediaType> readSeriesData(String filePath)
    + ArrayList<User> readUserData(String filePath)
    + void saveUserData(String filePath, ArrayList<User> users)
}

' Relationer
Main --> Menu : starter
Menu --> StreamingPlatform : bruger
StreamingPlatform "1" o-- "*" User : har
StreamingPlatform "1" o-- "*" MediaType : indeholder katalog
MediaType "1" o-- "*" Category : tilhører
Series "1" *-- "*" Season : indeholder
Season "1" *-- "*" Episode : indeholder
User "1" o-- "*" MediaType : har sete / gemte
FileIO ..> MediaType : indlæser til
FileIO ..> User : indlæser / gemmer

@enduml